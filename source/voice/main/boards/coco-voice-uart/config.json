{
  "type": "coco-voice-uart",
  "target": "esp32s3",
  "builds": [
    {
      "name": "coco-voice-uart",
      "sdkconfig_append": [
        "CONFIG_BOARD_TYPE_COCO_VOICE_UART=y",
        "CONFIG_ESPTOOLPY_FLASHMODE_DIO=y",
        "CONFIG_USE_CUSTOM_WAKE_WORD=y",
        "CONFIG_CUSTOM_WAKE_WORD=\"hei kou kou\"",
        "CONFIG_CUSTOM_WAKE_WORD_DISPLAY=\"嘿Coco\"",
        "CONFIG_CUSTOM_WAKE_WORD_THRESHOLD=20",
        "CONFIG_SR_MN_CN_MULTINET7_QUANT=y",
        "CONFIG_SR_MN_EN_NONE=y",
        "CONFIG_SEND_WAKE_WORD_DATA=n"
      ]
    }
  ]
}
